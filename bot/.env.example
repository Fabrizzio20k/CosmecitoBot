# Copia este archivo como bot/.env para ejecutar el bot fuera de Docker.
DISCORD_TOKEN=reemplaza_esto_por_el_token_del_bot
DISCORD_GUILD_ID=123456789012345678
DISCORD_SYNC_COMMANDS=true

LLAMA_CPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_CPP_MODEL=qwen2.5-1.5b-instruct-q4_k_m.gguf
LLAMA_CPP_TIMEOUT_SECONDS=600
LLAMA_CPP_CONTEXT_TOKENS=8192
LLAMA_CPP_MAX_RESPONSE_TOKENS=256
CHAT_RATE_LIMIT_SECONDS=10
CHAT_MAX_RECENT_MESSAGES=10

RAG_EMBEDDING_BASE_URL=http://127.0.0.1:8081/v1
RAG_EMBEDDING_MODEL=qwen3-embedding-4b-q4_k_m.gguf
RAG_TOP_K=4
RAG_MIN_SCORE=0.45
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=course_knowledge
QDRANT_VECTOR_NAME=embedding
