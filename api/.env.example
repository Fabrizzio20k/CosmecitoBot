# Copia este archivo como api/.env para ejecutar FastAPI fuera de Docker.
API_ADMIN_TOKEN=reemplaza_esto_por_un_token_largo_y_aleatorio
API_DOCUMENT_MAX_BYTES=5000000

# Necesarios sólo para que la UI administrativa pueda listar y validar roles.
# Usa el mismo bot y servidor que el servicio bot; nunca pongas un secreto real aquí.
DISCORD_TOKEN=reemplaza_esto_por_el_token_del_bot
DISCORD_GUILD_ID=123456789012345678

QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=course_knowledge
QDRANT_VECTOR_NAME=embedding

RAG_EMBEDDING_BASE_URL=http://127.0.0.1:8081/v1
RAG_EMBEDDING_MODEL=qwen3-embedding-4b-q4_k_m.gguf
RAG_CHUNK_SIZE=1600
RAG_CHUNK_OVERLAP=200
