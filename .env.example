# Nunca subas el archivo .env real al repositorio.
DISCORD_TOKEN=pega_aqui_el_token_del_bot
DISCORD_GUILD_ID=123456789012345678

# true cuando agregues o cambies slash commands; false para usar watchfiles
# sin hacer una sincronizacion con Discord en cada reinicio.
DISCORD_SYNC_COMMANDS=true

LLAMA_CPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_CPP_MODEL=Qwen3.5-9B-Q4_K_M.gguf
LLAMA_CPP_TIMEOUT_SECONDS=600
LLAMA_CPP_CONTEXT_TOKENS=8192
LLAMA_CPP_MAX_RESPONSE_TOKENS=256
CHAT_DATABASE_PATH=data/chat_history.sqlite3
