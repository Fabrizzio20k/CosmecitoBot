# Nunca subas el archivo .env real al repositorio.
DISCORD_TOKEN=pega_aqui_el_token_del_bot
DISCORD_GUILD_ID=123456789012345678

# true cuando agregues o cambies slash commands; false para usar watchfiles
# sin hacer una sincronizacion con Discord en cada reinicio.
DISCORD_SYNC_COMMANDS=true

LLAMA_CPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_CPP_MODEL=qwen2.5-1.5b-instruct-q4_k_m.gguf
LLAMA_CPP_TIMEOUT_SECONDS=600
LLAMA_CPP_CONTEXT_TOKENS=8192
LLAMA_CPP_MAX_RESPONSE_TOKENS=256
CHAT_DATABASE_PATH=data/chat_history.sqlite3
CHAT_RATE_LIMIT_SECONDS=10
CHAT_MAX_RECENT_MESSAGES=10

# RAG: MODE=embeddings ./run_ia.sh expone este endpoint con llama.cpp.
RAG_EMBEDDING_BASE_URL=http://127.0.0.1:8081/v1
RAG_EMBEDDING_MODEL=qwen3-embedding-4b-q4_k_m.gguf
RAG_TOP_K=4
# Qdrant devuelve similitud coseno: se conservan resultados con score >= este valor.
RAG_MIN_SCORE=0.45
RAG_CHUNK_SIZE=1600
RAG_CHUNK_OVERLAP=200

# En Docker Compose se reemplaza por http://qdrant:6333 y no se expone al host.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=course_knowledge
QDRANT_VECTOR_NAME=embedding

# API/UI de administración. Usa un secreto largo y aleatorio para API_ADMIN_TOKEN.
# Solo API y el proxy de servidor de Next.js lo reciben; nunca llega al navegador.
API_ADMIN_TOKEN=reemplaza_esto_por_un_token_largo_y_aleatorio
API_DOCUMENT_MAX_BYTES=5000000
